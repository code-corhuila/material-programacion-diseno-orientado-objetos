    <generalfeedback format="html"><text><![CDATA[<p>Extraer el método/clase común (DRY): una sola representación del conocimiento.</p>]]></text></generalfeedback>
    <defaultgrade>0.5000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering>
    <answer fraction="100" format="html"><text><![CDATA[Extraer el código común (DRY)]]></text><feedback format="html"><text><![CDATA[Correcto.]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Copiarlo a más clases]]></text><feedback format="html"><text><![CDATA[Aumenta la duplicación.]]></text></feedback></answer>
