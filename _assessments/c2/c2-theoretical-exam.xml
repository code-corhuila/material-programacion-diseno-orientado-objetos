    <answer fraction="100" format="html"><text><![CDATA[Es más flexible y genera menos acoplamiento]]></text><feedback format="html"><text><![CDATA[Correcto.]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Siempre usa menos memoria]]></text><feedback format="html"><text><![CDATA[No es una cuestión de memoria.]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Evita escribir métodos]]></text><feedback format="html"><text><![CDATA[No se trata de eso.]]></text></feedback></answer>
  </question>

