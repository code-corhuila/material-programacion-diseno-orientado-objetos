  <question type="multichoice">
    <name><text>P2T14 - EN Liskov</text></name>
    <questiontext format="html"><text><![CDATA[<p><em>(English)</em> Liskov Substitution Principle: a subclass...</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Must be usable wherever its superclass is expected, without breaking expected behavior.</p>]]></text></generalfeedback>
    <defaultgrade>0.2500000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering>
    <answer fraction="100" format="html"><text><![CDATA[Must be substitutable for its superclass without breaking behavior]]></text><feedback format="html"><text><![CDATA[Correct.]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Must override every method]]></text><feedback format="html"><text><![CDATA[Not required by LSP.]]></text></feedback></answer>
    <answer fraction="0" format="html"><text><![CDATA[Must be abstract]]></text><feedback format="html"><text><![CDATA[Unrelated to LSP.]]></text></feedback></answer>
  </question>

